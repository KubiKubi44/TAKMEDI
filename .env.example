# --- Databáze -------------------------------------------------------------
# Port 5432 = lokálně nainstalovaný PostgreSQL. Používáš-li docker-compose.yml,
# který běží vedle lokální instalace, změň port na 5433.
# Vlastník schématu. Používá se JEN pro migrace (prisma migrate).
DATABASE_URL="postgresql://medpredani_owner:zmen-me@localhost:5432/medpredani?schema=public"

# Aplikační role. Nemá BYPASSRLS – veškerý provoz jde přes ni a podléhá RLS.
APP_DATABASE_URL="postgresql://medpredani_app:zmen-me@localhost:5432/medpredani?schema=public"

# Rozlišovací role. Smí jen dohledat ordinaci podle slugu a token podle hashe.
# Práva jsou vynucená GRANTy v databázi, ne aplikačním kódem.
RESOLVER_DATABASE_URL="postgresql://medpredani_resolver:zmen-me@localhost:5432/medpredani?schema=public"

# --- Kryptografie ---------------------------------------------------------
# 32 bajtů v base64. Vygeneruj: openssl rand -base64 32
# Šifruje soubory (obálkové šifrování) a citlivá pole v databázi.
FILE_MASTER_KEY=""

# 32 bajtů v base64. Pepper pro HMAC krátkých tajemství (kód předání, PIN,
# datum narození, tajemství NFC čipu). Únik databáze bez něj kód neprozradí.
SECRET_PEPPER=""

# --- Úložiště souborů -----------------------------------------------------
# Ovladač: "filesystem" (vývoj, soubory na disku) nebo "s3" (produkce).
# Když není nastavený, odvodí se z NODE_ENV: development → filesystem, production → s3.
STORAGE_DRIVER="filesystem"
STORAGE_LOCAL_DIR="./uploads-dev"

# Následující platí jen pro ovladač s3.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="eu-central-1"
STORAGE_BUCKET="medpredani"
STORAGE_ACCESS_KEY_ID="medpredani"
STORAGE_SECRET_ACCESS_KEY="medpredani-dev-heslo"
STORAGE_FORCE_PATH_STYLE="true"

# --- Aplikace -------------------------------------------------------------
# Veřejná adresa. Používá se pro odkazy na NFC čipu a v e-mailech.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- E-mail ---------------------------------------------------------------
# console = vypisuje do konzole (vývoj), smtp = reálné odesílání
EMAIL_DRIVER="console"
EMAIL_FROM="ordinace@example.cz"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Testy ----------------------------------------------------------------
# Testy si databázi samy migrují a čistí. Musí ukazovat na JINOU databázi.
TEST_DATABASE_URL="postgresql://medpredani_owner:zmen-me@localhost:5432/medpredani_test?schema=public"
TEST_APP_DATABASE_URL="postgresql://medpredani_app:zmen-me@localhost:5432/medpredani_test?schema=public"
TEST_RESOLVER_DATABASE_URL="postgresql://medpredani_resolver:zmen-me@localhost:5432/medpredani_test?schema=public"

# --- Server Actions -------------------------------------------------------
# 32 bajtů v base64. Musí být nastavený UŽ PŘI BUILDU a končí v build artefaktu,
# takže to NESMÍ být stejná hodnota jako FILE_MASTER_KEY nebo SECRET_PEPPER.
# Bez něj se po každém buildu změní identifikátory Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Reverzní proxy -------------------------------------------------------
# Kolik proxy stojí před aplikací. 0 = hlavičce x-forwarded-for se nevěří.
# Proxy musí tuhle hlavičku PŘEPISOVAT, ne přidávat k hodnotě od klienta.
# Pozor: doporučované nginx `proxy_add_x_forwarded_for` klientovu hodnotu ZACHOVÁ.
TRUSTED_PROXY_HOPS="0"

# --- Úklid po expiraci ----------------------------------------------------
# Tajemství pro cron. Bez něj se cesta /api/udrzba/uklid tváří, že neexistuje.
# Vygeneruj: openssl rand -base64 32
# Cron: 0 3 * * * curl -fsS -X POST -H "X-Uklid-Token: ..." https://.../api/udrzba/uklid
CLEANUP_TOKEN=""
